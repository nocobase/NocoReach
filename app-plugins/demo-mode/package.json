{
  "name": "@nocobase/app-plugin-demo-mode",
  "version": "0.0.1",
  "description": "Turns a NocoBase app into a demo: an application's demo dataset imported, cleared and reset from its pages or a schedule, a simulated model for its agents, and an optional read-only mode in which visitors browse everything and every change is refused.",
  "type": "module",
  "exports": {
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server/tokens": {
      "types": "./dist/server/tokens.d.ts",
      "import": "./dist/server/tokens.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client/plugin": {
      "types": "./dist/client/plugin.d.ts",
      "import": "./dist/client/plugin.js"
    },
    "./client/react-providers": {
      "types": "./dist/client/react-providers/index.d.ts",
      "import": "./dist/client/react-providers/index.js"
    },
    "./client/demo-data": {
      "types": "./dist/client/demo-data.d.ts",
      "import": "./dist/client/demo-data.js"
    },
    "./package.json": "./package.json",
    "./client/demo-configuration": {
      "types": "./dist/client/demo-configuration.d.ts",
      "import": "./dist/client/demo-configuration.js"
    }
  },
  "imports": {
    "#components/*": "./dist/client/components/*.js",
    "#hooks/*": "./dist/client/hooks/*.js",
    "#lib/*": "./dist/client/lib/*.js",
    "#extensions/*": "./dist/client/extensions/*.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=24.0.0"
  }
}

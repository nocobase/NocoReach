    "typecheck": "pnpm --dir apps/nocoreach typecheck",
    "test:business": "cd apps/nocoreach && TSX_TSCONFIG_PATH=tsconfig.server.json node --import tsx --test ../../tests/unit/*.test.cjs"
  }
}

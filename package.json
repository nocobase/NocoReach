{
  "name": "nocoreach",
  "private": true,
  "scripts": {
    "test": "pnpm --dir apps/nocoreach test && pnpm --dir apps/nocoreach test:domain && pnpm test:business",
    "test:e2e": "pnpm --dir apps/nocoreach test:e2e",
    "build": "pnpm --dir apps/nocoreach build",
    "dev": "pnpm --dir apps/nocoreach dev",

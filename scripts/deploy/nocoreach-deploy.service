[Unit]
Description=NocoReach deployment webhook
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/nocoreach-deploy/service.py /etc/nocoreach-deploy/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
CPUAccounting=true
CPUQuota=25%
MemoryAccounting=true
MemoryLimit=256M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
